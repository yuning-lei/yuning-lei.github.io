---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EntryList from '../../components/EntryList.astro';
import { isPublicEntry } from '../../lib/content';
const entries = (await getCollection('research', isPublicEntry)).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Research" description="Yuning Lei’s research areas: micro and nanorobotics, SEM-based nanomanipulation, micro/nanofabrication and microactuation.">
  <PageIntro eyebrow="Research / Areas of focus" title="Research at small scales." description="Microrobotics, nanorobotics, SEM-based nanomanipulation, micro/nanofabrication and microactuation." />
  <section class="shell page-body" aria-label="Research areas"><EntryList entries={entries} collection="research" /></section>
</Layout>
