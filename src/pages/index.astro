---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EntryList from '../components/EntryList.astro';
import { getSite } from '../data/site';
import { getProfile } from '../data/localized-profile';
import { localizedCollection } from '../lib/localized-content';
import { localeFromPath, localePath, tr } from '../lib/i18n';
import FeaturedWork from '../components/FeaturedWork.astro';
import ActivityHighlights from '../components/ActivityHighlights.astro';
import { newestFirst } from '../lib/news';

const locale = localeFromPath(Astro.url.pathname);
const site = getSite(locale);
const profile = getProfile(locale);
const t = (en: string, zh: string) => tr(locale, en, zh);
const research = (await localizedCollection('research', locale)).sort((a, b) => a.data.order - b.data.order);
const activities = (await localizedCollection('news', locale)).filter(entry => entry.data.featured).sort(newestFirst).slice(0, 3);
const projects = (await localizedCollection('projects', locale)).filter(entry => entry.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const publications = (await localizedCollection('publications', locale))
  .filter(entry => entry.data.featured && 'publicationStatus' in entry.data && entry.data.publicationStatus === 'published')
  .sort((a, b) => ('year' in b.data ? b.data.year : 0) - ('year' in a.data ? a.data.year : 0))
  .slice(0, 3);
---
<Layout>
  <section class="shell hero" aria-labelledby="intro-heading">
    <div class="hero-copy">
      <p class="eyebrow">{t('Research / Micro & nanorobotics', '研究 / 微机器人与纳米机器人')}</p>
      <h1 id="intro-heading">{site.name}<span class="hero-degree">{site.qualification}</span></h1>
      <p class="hero-role">{site.role}<br /><span>{site.institution}{t(', Germany', '，德国')}</span></p>
      <p class="hero-description">{t('My research focuses on microrobotics, nanorobotics, SEM-based nanomanipulation, micro/nanofabrication and microactuation.', '我的研究聚焦于微机器人、纳米机器人、扫描电子显微镜下的纳米操纵、微纳制造与微致动。')}</p>
      <div class="hero-actions"><a class="button" href={localePath('/research/', locale)}>{t('Explore research', '了解研究方向')} <Arrow /></a><a class="text-link" href={localePath('/about/', locale)}>{t('About me', '关于我')} <Arrow diagonal /></a></div>
    </div>
    <FeaturedWork />
  </section>

  {research.length > 0 && <section class="research-band" aria-labelledby="research-heading">
    <div class="shell section research-section">
      <div class="section-aside"><p class="eyebrow">{t('Research themes', '研究主题')}</p><h2 id="research-heading">{t('Areas of focus.', '研究方向')}</h2><p>{t('Long-term research specializations across robotics, manipulation and fabrication.', '围绕机器人技术、微纳操纵与制造开展长期研究。')}</p><a class="text-link" href={localePath('/research/', locale)}>{t('Research overview', '研究概览')} <Arrow /></a></div>
      <EntryList entries={research} collection="research" headingLevel={3} />
    </div>
  </section>}

  <ActivityHighlights entries={activities} />

  {projects.length > 0 && <section class="shell section" aria-labelledby="projects-heading">
    <div class="section-heading"><p class="eyebrow">{t('Selected work', '项目选介')}</p><h2 id="projects-heading">{t('Research projects.', '研究项目')}</h2></div>
    <EntryList entries={projects} collection="projects" headingLevel={3} />
    <a class="text-link section-link" href={localePath('/projects/', locale)}>{t('All projects', '全部项目')} <Arrow /></a>
  </section>}

  {publications.length > 0 && <section class="shell section" aria-labelledby="publications-heading">
    <div class="section-heading"><p class="eyebrow">{t('Scientific contributions', '学术成果')}</p><h2 id="publications-heading">{t('Featured publications.', '论文选介')}</h2></div>
    <EntryList entries={publications} collection="publications" headingLevel={3} />
    <a class="text-link section-link" href={localePath('/publications/', locale)}>{t('All publications', '全部学术成果')} <Arrow /></a>
  </section>}

  <section class="shell section profile-section" aria-labelledby="profile-heading">
    <div><p class="eyebrow">{t('Academic profile', '学术履历')}</p><h2 id="profile-heading">{t('About Yuning.', '关于 Yuning Lei')}</h2></div>
    <div><p class="profile-lead">{t(`I am a ${site.role} in ${profile.group} at the ${site.institution}.`, '我在奥尔登堡大学微机器人与控制工程研究组（AMiR）担任科研人员（Research Associate）。')}</p><p>{t('I received my Ph.D. in Engineering Science from Université Bourgogne Franche-Comté in 2023, following doctoral research on nanorobotic origami at FEMTO-ST Institute.', '我在 FEMTO-ST 研究所开展纳米机器人折纸研究，并于 2023 年获得勃艮第—弗朗什孔泰大学（Université Bourgogne Franche-Comté）工程科学博士学位。')}</p><a class="text-link section-link" href={localePath('/about/', locale)}>{t('About & CV', '关于我与简历')} <Arrow diagonal /></a></div>
  </section>
  <section class="shell home-contact" aria-labelledby="contact-heading"><div><p class="eyebrow">{t('Contact', '联系')}</p><h2 id="contact-heading">{t('Research & collaboration.', '科研交流与合作')}</h2></div><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <Arrow diagonal /></a></section>
</Layout>
