---
import { getEntries, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { isPublicEntry } from '../../lib/content';
import PublicationCitation from '../../components/PublicationCitation.astro';
import PublicationLinks from '../../components/PublicationLinks.astro';
import EntryList from '../../components/EntryList.astro';
import { detailPaths } from '../../lib/paths';
import { localizeEntry } from '../../lib/localized-content';
import { localeFromPath, localePath, collectionLabel, publicationStatusLabel, tr } from '../../lib/i18n';
export async function getStaticPaths() {
  return detailPaths();
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry: source, collection } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const entry = await localizeEntry<'research' | 'projects' | 'publications'>(source, locale);
const { Content } = await render(entry.translation ?? source);
const related = entry.data.visibility === 'public' ? await Promise.all((await getEntries<'publications'>(entry.data.relatedPublications)).filter(isPublicEntry).map(item => localizeEntry<'publications'>(item, locale))) : [];
---
<Layout title={entry.view.title} description={entry.view.summary}>
  <article class="shell detail-page">
    <a class="text-link back-link" href={localePath(`/${collection}/`, locale)}><span aria-hidden="true">←</span> {tr(locale, `Back to ${collection}`, `返回${collectionLabel(collection, locale)}`)}</a>
    <p class="eyebrow">{entry.view.category}</p>
    <h1>{entry.view.title}</h1>
    {locale === 'zh' && entry.collection === 'publications' && entry.data.visibility === 'public' && <p class="original-title"><span>原题：</span><span lang={entry.data.publicationType === 'thesis' ? 'fr' : 'en'}>{entry.data.title}</span></p>}
    <p class="page-description">{entry.view.summary}</p>
    {'publicationStatus' in entry.data && <p class="publication-status">{publicationStatusLabel(entry.data.publicationStatus, locale, entry.data.publicationType === 'thesis')}</p>}
    {entry.view.role && <p class="detail-role">{entry.view.role}{entry.view.period && <> · {entry.view.period}</>}</p>}
    {entry.collection === 'publications' && <><PublicationCitation data={entry.data} /><PublicationLinks entry={entry} /></>}
    <div class="prose"><Content /></div>
    {related.length > 0 && <section class="related-publications" aria-labelledby="related-heading"><h2 id="related-heading">{tr(locale, 'Related publications', '相关论文')}</h2><EntryList entries={related} collection="publications" headingLevel={3} /></section>}
  </article>
</Layout>
