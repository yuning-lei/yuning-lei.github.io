---
import { getCollection, getEntries, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { isPublicEntry } from '../../lib/content';
import PublicationCitation from '../../components/PublicationCitation.astro';
import PublicationLinks from '../../components/PublicationLinks.astro';
import EntryList from '../../components/EntryList.astro';
export async function getStaticPaths() {
  const collections = ['research', 'projects', 'publications'] as const;
  const pages = await Promise.all(collections.map(async (collection) => {
    const entries = await getCollection(collection, isPublicEntry);
    return entries.map(entry => ({ params: { collection, id: entry.id }, props: { entry, collection } }));
  }));
  return pages.flat();
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, collection } = Astro.props;
const { Content } = await render(entry);
const related = entry.data.visibility === 'public' ? (await getEntries(entry.data.relatedPublications)).filter(isPublicEntry) : [];
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="shell detail-page">
    <a class="text-link back-link" href={`/${collection}/`}><span aria-hidden="true">←</span> Back to {collection}</a>
    <p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="page-description">{entry.data.summary}</p>
    {'publicationStatus' in entry.data && <p class="publication-status">{entry.data.publicationStatus}</p>}
    {'role' in entry.data && entry.data.role && <p class="detail-role">{entry.data.role}{entry.data.period && <> · {entry.data.period}</>}</p>}
    {entry.collection === 'publications' && <><PublicationCitation data={entry.data} /><PublicationLinks entry={entry} /></>}
    <div class="prose"><Content /></div>
    {related.length > 0 && <section class="related-publications" aria-labelledby="related-heading"><h2 id="related-heading">Related publications</h2><EntryList entries={related} collection="publications" headingLevel={3} /></section>}
  </article>
</Layout>
