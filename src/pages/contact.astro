---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getSite } from '../data/site';
import { getProfile } from '../data/localized-profile';
import { localeFromPath, tr } from '../lib/i18n';
import Arrow from '../components/Arrow.astro';
import OrcidLink from '../components/OrcidLink.astro';
const locale = localeFromPath(Astro.url.pathname);
const site = getSite(locale);
const profile = getProfile(locale);
const t = (en: string, zh: string) => tr(locale, en, zh);
---
<Layout title={t('Contact', '联系')} description={t('Contact Yuning Lei at the University of Oldenburg: professional email, institutional address and academic profiles.', '联系奥尔登堡大学的雷宇宁：工作邮箱、机构地址与学术主页。')}>
  <PageIntro eyebrow={t('Contact', '联系')} title={t('Research & collaboration.', '科研交流与合作')} description={t('For research inquiries and academic collaboration, please get in touch by email.', '欢迎通过电子邮件联系，交流研究问题与学术合作。')} />
  <div class="shell page-body contact-grid">
    <section class="affiliation-card" aria-labelledby="affiliation-heading"><p class="eyebrow">{site.institution}</p><h2 id="affiliation-heading">{site.name}, {site.qualification}</h2><p>{site.role}<br />{profile.department}<br />{profile.group}</p><address>{profile.address.map(line => <span>{line}</span>)}</address><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <Arrow diagonal /></a></section>
    <section class="academic-profiles" aria-labelledby="profiles-heading"><p class="eyebrow">{t('Find my work', '查找我的研究')}</p><h2 id="profiles-heading">{t('Academic & professional profiles', '学术与职业主页')}</h2><ul role="list"><li><OrcidLink /></li>{profile.links.map(link => <li><a class="text-link" href={link.href}>{link.label}<Arrow diagonal /></a></li>)}</ul></section>
  </div>
</Layout>
