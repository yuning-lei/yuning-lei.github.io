---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import { getSite } from '../data/site';
import { getProfile } from '../data/localized-profile';
import { Image } from 'astro:assets';
import portrait from '../assets/yuning-lei.webp';
import CurriculumVitae from '../components/CurriculumVitae.astro';
import OrcidLink from '../components/OrcidLink.astro';
import ConferenceContributions from '../components/ConferenceContributions.astro';
import PublicationCitation from '../components/PublicationCitation.astro';
import { localizedCollection } from '../lib/localized-content';
import { localeFromPath, localePath, tr } from '../lib/i18n';
import { publicationReadingUrl } from '../lib/publications';
const locale = localeFromPath(Astro.url.pathname);
const site = getSite(locale);
const profile = getProfile(locale);
const t = (en: string, zh: string) => tr(locale, en, zh);
const publications = (await localizedCollection('publications', locale)).sort((a, b) => ('year' in b.data ? b.data.year : 0) - ('year' in a.data ? a.data.year : 0));
---
<Layout title={t('About / CV', '关于我／简历')} description={t('About Yuning Lei, Ph.D., Research Associate at the University of Oldenburg, Germany.', '雷宇宁，博士，德国奥尔登堡大学博士后研究员的教育、科研、教学与学术服务经历。')}>
  <PageIntro eyebrow={t('About / Curriculum vitae', '关于我／个人简历')} title={`${site.name}${t(', Ph.D.', '，博士')}`} description={t('Research Associate in Microrobotics and Control Engineering at the University of Oldenburg, Germany.', '德国奥尔登堡大学微机器人与控制工程研究组博士后研究员。')} />
  <div class="shell page-body">
    <div class="profile-overview">
      <div><p>{t('I have been a Research Associate at the University of Oldenburg since April 2023. My research focuses on liquid-metal nanocharacterization, microassembly in SEM-FIB and nanorobotic structures.', '我自 2023 年 4 月起在奥尔登堡大学担任博士后研究员，研究液态金属纳米表征、扫描电镜—聚焦离子束系统（SEM-FIB）内的微装配及纳米机器人结构。')}</p><p>{t('I received my Ph.D. in Engineering Science from Université Bourgogne Franche-Comté in 2023, following doctoral research at FEMTO-ST Institute. I previously studied at the University of Orléans.', '我在 FEMTO-ST 研究所开展博士研究，于 2023 年获得勃艮第—弗朗什孔泰大学（Université Bourgogne Franche-Comté）工程科学博士学位，此前曾在奥尔良大学学习。')}</p><div class="profile-contact"><a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a><span>{site.location}</span><OrcidLink /></div><div class="hero-actions screen-only"><a class="button" href={profile.cvDownload} download>{t('Public CV (PDF)', '中文简历（PDF）')} <span aria-hidden="true">↓</span></a><a class="text-link" href={locale === 'en' ? '/files/yuning-lei-cv-zh.pdf' : '/files/yuning-lei-cv.pdf'} download lang={locale === 'en' ? 'zh-CN' : 'en'}>{t('中文简历（PDF）', 'English CV (PDF)')}</a><a class="text-link" href={localePath('/publications/', locale)}>{t('Publications', '学术成果')} <Arrow /></a></div><p class="record-date">{t(`Academic record as of ${profile.cvDate}.`, `学术信息截至 ${profile.cvDate}。`)}</p></div>
      <Image class="profile-portrait screen-only" src={portrait} alt={site.name} width={200} height={210} widths={[160, 240, 320, 480]} sizes="(max-width: 700px) 160px, 200px" format="webp" loading="eager" />
    </div>
    <nav class="cv-nav screen-only" aria-label={t('On this page', '本页目录')}><a href="#experience">{t('Experience', '科研经历')}</a><a href="#education">{t('Education', '教育背景')}</a><a href="#teaching">{t('Teaching', '教学')}</a><a href="#skills">{t('Skills', '技能')}</a><a href="#service">{t('Service', '学术服务')}</a><a href="#awards">{t('Awards', '奖励与资助')}</a></nav>
    <CurriculumVitae />
    <section class="print-only cv-section" aria-labelledby="cv-publications-heading"><div><h2 id="cv-publications-heading">{t('Publications', '学术成果')}</h2></div><div>{publications.map(entry => <article class="cv-print-publication"><h3>{entry.view.title}</h3>{locale === 'zh' && <p class="original-title" lang={entry.data.visibility === 'public' && entry.data.publicationType === 'thesis' ? 'fr' : 'en'}>{entry.data.title}</p>}<PublicationCitation data={entry.data} />{publicationReadingUrl(entry.data) && <p class="cv-print-doi"><a href={publicationReadingUrl(entry.data)}>{publicationReadingUrl(entry.data)}</a></p>}</article>)}</div></section>
    <section class="print-only cv-section" aria-labelledby="cv-contributions-heading"><div><h2 id="cv-contributions-heading">{t('Conference contributions', '会议报告')}</h2></div><ConferenceContributions /></section>
  </div>
</Layout>
