---
import Arrow from './Arrow.astro';
import { featuredWork } from '../data/featured-work';
---
<figure class="featured-work" aria-labelledby="featured-work-title">
  <div class="featured-work-header"><span class="eyebrow">Featured work</span><span class="featured-work-scale">{featuredWork.scale}</span></div>
  <a class="featured-work-image-link" href={featuredWork.original} aria-label="View the complete silica origami research figure (SVG)">
    <img class="featured-work-image" src={featuredWork.image} srcset={featuredWork.srcset} sizes="(min-width: 1262px) 640px, (min-width: 960px) 53vw, (min-width: 701px) 49vw, calc(100vw - 40px)" width="800" height="540" alt={featuredWork.alt} loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <figcaption>
    <h2 id="featured-work-title">{featuredWork.title}</h2>
    <p class="featured-work-description">{featuredWork.description}</p>
    <p class="featured-work-context">{featuredWork.context}</p>
    <div class="featured-work-footer"><span>{featuredWork.credit}</span><a class="text-link" href={featuredWork.original}>View full figure <Arrow diagonal /></a></div>
  </figcaption>
</figure>
