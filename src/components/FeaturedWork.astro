---
import Arrow from './Arrow.astro';
import { featuredWork } from '../data/featured-work';
import { localeFromPath, tr } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, zh: string) => tr(locale, en, zh);
---
<figure class="featured-work" aria-labelledby="featured-work-title">
  <div class="featured-work-header"><span class="eyebrow">{t('Featured work', '代表性作品')}</span><span class="featured-work-scale">{t(featuredWork.scale, '小于 50 µm')}</span></div>
  <a class="featured-work-image-link" href={featuredWork.original} aria-label={t('View the complete silica origami research figure (SVG)', '查看完整二氧化硅折纸研究图（SVG）')}>
    <img class="featured-work-image" src={featuredWork.image} srcset={featuredWork.srcset} sizes="(min-width: 1262px) 640px, (min-width: 960px) 53vw, (min-width: 701px) 49vw, calc(100vw - 40px)" width="800" height="540" alt={t(featuredWork.alt, '锥形光纤端部二氧化硅折纸结构的标注研究图，旁边以人类头发作比较。右下角保留原图的 20 µm 比例尺。')} loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <figcaption>
    <h2 id="featured-work-title">{t(featuredWork.title, '激光致动的二氧化硅折纸结构')}</h2>
    <p class="featured-work-description">{t(featuredWork.description, '安装在锥形光纤上的小于 50 µm 二氧化硅折纸结构。')}</p>
    <p class="featured-work-context">{t(featuredWork.context, '图中以人类头发作比较；比例尺为 20 µm。')}</p>
    <div class="featured-work-footer"><span>{t(featuredWork.credit, '图片由雷宇宁提供')}</span><a class="text-link" href={featuredWork.original}>{t('View full figure', '查看完整原图')} <Arrow diagonal /></a></div>
  </figcaption>
</figure>
