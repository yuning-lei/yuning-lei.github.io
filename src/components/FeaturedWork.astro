---
import Arrow from './Arrow.astro';
import { Image } from 'astro:assets';
import PhotoViewer from './PhotoViewer.astro';
import { featuredWork, featuredImages } from '../data/featured-work';
import { localeFromPath, tr } from '../lib/i18n';
import '../styles/news.css';
const locale = localeFromPath(Astro.url.pathname);
const t = (en: string, zh: string) => tr(locale, en, zh);
---
<figure class="featured-work" aria-labelledby="featured-work-title" data-gallery="featured-work" data-gallery-title={t('Featured research images', '代表性科研图像')}>
  <div class="featured-work-header"><span class="eyebrow">{t('Featured work', '代表性作品')}</span><span class="featured-work-scale">{t(featuredWork.scale, '小于 50 µm')}</span></div>
  <a class="featured-work-image-link" href={featuredWork.original} data-gallery-item
    data-caption={t(`${featuredWork.title}. ${featuredWork.description} ${featuredWork.context}`, '激光致动的二氧化硅折纸结构。安装在锥形光纤上的小于 50 µm 二氧化硅折纸结构，旁边以人类头发作比较，比例尺为 20 µm。')}
    data-photo-width="800" data-photo-height="540" aria-label={t('View the complete silica origami research figure (SVG)', '查看完整二氧化硅折纸研究图（SVG）')}>
    <img class="featured-work-image" src={featuredWork.image} srcset={featuredWork.srcset} sizes="(min-width: 1262px) 640px, (min-width: 960px) 53vw, (min-width: 701px) 49vw, calc(100vw - 40px)" width="800" height="540" alt={t(featuredWork.alt, '锥形光纤端部二氧化硅折纸结构的标注研究图，旁边以人类头发作比较。右下角保留原图的 20 µm 比例尺。')} loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <div class="featured-work-thumbnails" role="group" aria-label={t('More featured research images', '更多代表性科研图像')}>
    {featuredImages.map(photo => <a href={photo.image.src} data-gallery-item
      data-caption={`${t(photo.caption, photo.captionZh)} ${t('Image supplied by Yuning Lei.', '图片由雷宇宁提供。')}`}
      data-photo-width={photo.image.width} data-photo-height={photo.image.height}
      aria-label={t(`View ${photo.title}`, `查看${photo.titleZh}`)} title={t(photo.title, photo.titleZh)}>
      <Image src={photo.image} alt={t(photo.alt, photo.altZh)} width={128} widths={[80, 128, 256]} sizes="(min-width: 960px) 112px, 60px" format="webp" quality={90} loading="lazy" />
    </a>)}
  </div>
  <figcaption>
    <h2 id="featured-work-title">{t(featuredWork.title, '激光致动的二氧化硅折纸结构')}</h2>
    <p class="featured-work-description">{t(featuredWork.description, '安装在锥形光纤上的小于 50 µm 二氧化硅折纸结构。')}</p>
    <p class="featured-work-context">{t(featuredWork.context, '图中以人类头发作比较；比例尺为 20 µm。')}</p>
    <div class="featured-work-footer"><span>{t(featuredWork.credit, '图片由雷宇宁提供')}</span><a class="text-link" href={featuredWork.original}>{t('View full figure', '查看完整原图')} <Arrow diagonal /></a></div>
  </figcaption>
</figure>
<PhotoViewer />

<style>
  .featured-work-thumbnails { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; padding: 14px 16px 0; }
  .featured-work-thumbnails a { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 44px; aspect-ratio: 4 / 3; border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg); }
  .featured-work-thumbnails a:hover { border-color: var(--color-accent); }
  .featured-work-thumbnails img { display: block; width: 100%; height: 100%; object-fit: contain; }
</style>
