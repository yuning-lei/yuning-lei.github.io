---
import { getConferenceContributions } from '../data/localized-profile';
import { localizeOwnerName } from '../data/site';
import { localeFromPath, localePath, tr } from '../lib/i18n';
import Arrow from './Arrow.astro';
const locale = localeFromPath(Astro.url.pathname);
const entries = getConferenceContributions(locale);
---
<div class="conference-contributions">
  {entries.map(item => <article class="conference-contribution">
    <p class="eyebrow">{item.kind} · {item.year}</p>
    <h3>{item.title}</h3>
    {item.originalTitle && <p class="original-title"><span>{tr(locale, 'Original title: ', '原题：')}</span><span lang="en">{item.originalTitle}</span></p>}
    <p class="contribution-authors">{item.speaker ? <>{tr(locale, 'Speaker: ', '报告人：')}<strong>{localizeOwnerName(item.speaker, locale)}</strong></> : item.authors?.map((author, index) => <>{index > 0 && '; '}{author === 'Yuning Lei' ? <strong>{localizeOwnerName(author, locale)}</strong> : author}</>)}</p>
    <p>{item.venue} · {item.location}</p>
    <p>{item.description}</p>
    <a class="text-link screen-only" href={localePath(item.link.href, locale)}>{item.link.label} <Arrow diagonal /></a>
  </article>)}
</div>
<style>
  .conference-contribution { border-top: 1px solid var(--color-border); padding-block: 25px; max-width: 850px; }
  .conference-contribution h3 { font-size: 1.2rem; margin-top: 8px; line-height: 1.5; }
  .conference-contribution > p:not(.eyebrow) { font-size: .82rem; margin-top: 10px; }
  .contribution-authors strong { color: var(--color-ink); font-weight: 600; }
  .conference-contribution > .text-link { font-size: .76rem; margin-top: 15px; }
  @media print { .conference-contributions { break-inside: avoid; } .conference-contribution { border: 0; padding: 0; break-inside: avoid; } .conference-contribution + .conference-contribution { margin-top: 8px; } .conference-contribution h3 { font-size: 10pt; margin-top: 0; } .conference-contribution > p:not(.eyebrow) { font-size: 9pt; margin-top: 4px; line-height: 1.5; } }
</style>
