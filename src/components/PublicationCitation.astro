---
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'publications'>['data']; }
const { data } = Astro.props;
---
{data.visibility === 'public' && <div class="citation-block">
  <p class="citation-authors">{data.authors.map((author, index) => <>{index > 0 && '; '}{author === 'Yuning Lei' || author === 'Y. Lei' ? <strong>{author}</strong> : author}</>)}</p>
  <p class="citation-venue"><cite>{data.venue}</cite>{data.volume && <>, {data.volume}</>}{data.issue && <>({data.issue})</>}{data.pages && <>, pp. {data.pages}</>}{data.articleNumber && <>, article {data.articleNumber}</>}, {data.year}.</p>
</div>}
