---
import { getProfile } from '../data/localized-profile';
import { localeFromPath, tr } from '../lib/i18n';
import CvTimeline from './CvTimeline.astro';
const locale = localeFromPath(Astro.url.pathname);
const profile = getProfile(locale);
const t = (en: string, zh: string) => tr(locale, en, zh);
---
<div class="cv-content">
  <section class="cv-section" id="experience" aria-labelledby="experience-heading"><div><p class="eyebrow">{t('Career', '科研经历')}</p><h2 id="experience-heading">{t('Research & experience', '科研与工作经历')}</h2></div><CvTimeline entries={profile.appointments} /></section>
  <section class="cv-section" id="education" aria-labelledby="education-heading"><div><p class="eyebrow">{t('Academic background', '学习经历')}</p><h2 id="education-heading">{t('Education', '教育背景')}</h2></div><CvTimeline entries={profile.education} /></section>
  <section class="cv-section" id="teaching" aria-labelledby="teaching-heading"><div><p class="eyebrow">{t('Teaching', '教学')}</p><h2 id="teaching-heading">{t('Lectures & tutorials', '讲授与习题课')}</h2></div><div class="cv-timeline">{profile.teaching.map(course => <article class="cv-entry"><p class="cv-period">{course.period}</p><div><h3>{course.title}</h3><p class="cv-institution">{course.institution}</p><p class="cv-description">{course.format} · {course.workload}</p></div></article>)}</div></section>
  <section class="cv-section" id="skills" aria-labelledby="skills-heading"><div><p class="eyebrow">{t('Methods & tools', '方法与工具')}</p><h2 id="skills-heading">{t('Technical skills', '技术技能')}</h2></div><dl class="cv-skills">{profile.skills.map(skill => <div class="cv-skill"><dt>{skill.title}</dt><dd>{skill.description}</dd></div>)}</dl></section>
  <section class="cv-section" id="service" aria-labelledby="service-heading"><div><p class="eyebrow">{t('Academic community', '学术社区')}</p><h2 id="service-heading">{t('Service & memberships', '学术服务与组织成员')}</h2></div><div class="cv-timeline">{profile.service.map(item => <article class="cv-entry"><p class="cv-period">{item.period}</p><div><h3>{item.title}</h3><p class="cv-description">{item.description}</p></div></article>)}</div></section>
  <section class="cv-section" id="awards" aria-labelledby="awards-heading"><div><p class="eyebrow">{t('Recognition', '奖励与资助')}</p><h2 id="awards-heading">{t('Honors & fellowships', '荣誉与奖学金')}</h2></div><div class="cv-timeline">{profile.awards.map(award => <article class="cv-entry"><p class="cv-period">{award.period}</p><div><h3>{award.title}</h3><p class="cv-description">{award.event}</p></div></article>)}</div></section>
  <section class="cv-section" aria-labelledby="qualification-heading"><div><p class="eyebrow">{t('Qualification', '任职资格')}</p><h2 id="qualification-heading">{t('CNU qualification', 'CNU 任职资格')}</h2></div><article class="cv-entry"><p class="cv-period">{profile.qualification.period}</p><div><h3>{profile.qualification.title}</h3><p class="cv-description">{profile.qualification.description}</p></div></article></section>
  <section class="cv-section" aria-labelledby="languages-heading"><div><p class="eyebrow">{t('Languages', '语言能力')}</p><h2 id="languages-heading">{t('Languages', '语言能力')}</h2></div><dl class="cv-skills">{profile.languages.map(language => <div class="cv-skill"><dt>{language.name}</dt><dd>{language.description}</dd></div>)}</dl></section>
</div>
