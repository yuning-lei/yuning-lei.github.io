---
import { navigation, getSite } from '../data/site';
import { localeFromPath, localePath, tr } from '../lib/i18n';
const path = Astro.url.pathname;
const locale = localeFromPath(path);
const site = getSite(locale);
const other = locale === 'en' ? 'zh' : 'en';
const labels: Record<string, string> = { Research: '研究方向', Publications: '学术成果', Projects: '研究项目', About: '关于我', Contact: '联系' };
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={localePath('/', locale)} aria-current={path === localePath('/', locale) ? 'page' : undefined}>
      <span class="monogram" aria-hidden="true">YL<span>.</span></span>
      <span>{site.name}<small>{tr(locale, 'Academic portfolio', '学术主页')}</small></span>
    </a>
    <a class="language-switch" data-language-switch href={localePath(path, other)} lang={other === 'zh' ? 'zh-CN' : 'en'} hreflang={other === 'zh' ? 'zh-CN' : 'en'} title={tr(locale, 'Read this page in Chinese', '切换到对应的英文页面')}>{tr(locale, '中文', 'English')}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" hidden>
      <span>{tr(locale, 'Menu', '菜单')}</span><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 14h14" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <nav id="primary-nav" aria-label={tr(locale, 'Main navigation', '主导航')}>
      {navigation.map(({ label, href }) => <a href={localePath(href, locale)} aria-current={path.startsWith(localePath(href, locale)) ? 'page' : undefined}>{tr(locale, label, labels[label])}</a>)}
    </nav>
  </div>
</header>
<script>
  const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
  if (languageLink) {
    const keepAnchor = () => {
      const target = new URL(languageLink.href);
      languageLink.setAttribute('href', target.pathname + target.search + location.hash);
    };
    keepAnchor();
    window.addEventListener('hashchange', keepAnchor);
  }
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  if (button && nav) {
    button.hidden = false;
    nav.classList.add('collapsible');
    const close = () => button.setAttribute('aria-expanded', 'false');
    button.addEventListener('click', () => button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true')));
    nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { close(); button.focus(); }
    });
    matchMedia('(min-width: 960px)').addEventListener('change', close);
  }
</script>
